rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserDoc() {
      return get(currentUserPath());
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function isAdmin() {
      return signedIn() &&
        exists(currentUserPath()) &&
        currentUserData().role == 'admin';
    }

    function isCollector() {
      return signedIn() &&
        exists(currentUserPath()) &&
        currentUserData().role == 'collector';
    }

    function isEmployee() {
      return signedIn() &&
        exists(currentUserPath()) &&
        currentUserData().role == 'employee';
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function taskCreator() {
      return resource.data.assignedBy == request.auth.uid;
    }

    function taskAssignee() {
      return resource.data.assignedTo == request.auth.uid;
    }

    function creatingOwnTask() {
      return request.resource.data.assignedBy == request.auth.uid;
    }

    function onlyAllowedTaskStatusFieldsChanged() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'status',
          'updatedAt',
          'completedAt',
          'updatedBy',
          'updatedByName',
          'currentCount',
        ]);
    }

    function relatedTask(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId));
    }

    function canReadTaskLog(taskId) {
      return isAdmin() ||
        relatedTask(taskId).data.assignedBy == request.auth.uid ||
        relatedTask(taskId).data.assignedTo == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isAdmin() || isCurrentUser(userId);

      allow update: if isAdmin() || (
        isCurrentUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['languageCode', 'name'])
      );

      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || taskCreator() || taskAssignee();

      allow create: if signedIn() && (
        creatingOwnTask()
      );

      allow update: if (
        (isAdmin() || taskCreator())
        && request.resource.data.assignedBy == resource.data.assignedBy
      ) || (taskAssignee() && onlyAllowedTaskStatusFieldsChanged());

      allow delete: if isAdmin() || taskCreator();

      match /attachments/{attachmentId} {
        allow read: if isAdmin()
          || relatedTask(taskId).data.assignedBy == request.auth.uid
          || relatedTask(taskId).data.assignedTo == request.auth.uid;

        allow create: if signedIn()
          && request.resource.data.uploadedBy == request.auth.uid
          && (
            (request.resource.data.type == 'brief'
              && (isAdmin()
                  || relatedTask(taskId).data.assignedBy == request.auth.uid))
            ||
            (request.resource.data.type == 'evidence'
              && (isAdmin()
                  || relatedTask(taskId).data.assignedTo == request.auth.uid))
          );

        allow update: if false;
        allow delete: if isAdmin()
          || relatedTask(taskId).data.assignedBy == request.auth.uid
          || resource.data.uploadedBy == request.auth.uid;
      }
    }

    match /task_logs/{logId} {
      allow read: if signedIn() && canReadTaskLog(resource.data.taskId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    match /task_templates/{templateId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.assignedBy == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.assignedBy == resource.data.assignedBy;
      allow delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /attendance_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fcm_tokens/{userId} {
      allow write: if isCurrentUser(userId);
      allow read: if false;
    }

    match /schedules/{userId} {
      allow read: if isAdmin() || isCurrentUser(userId);
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Collections subsystem (v2.0.0) ──────────────────────────────────────

    match /customers/{customerId} {
      allow read: if isAdmin() ||
        (isCollector() && resource.data.assignedCollectorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /debts/{debtId} {
      allow read: if isAdmin() ||
        (isCollector() && resource.data.assignedCollectorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /installment_plans/{planId} {
      allow read: if isAdmin() ||
        (isCollector() &&
          get(/databases/$(database)/documents/debts/$(resource.data.debtId))
            .data.assignedCollectorId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;

      match /installments/{installmentId} {
        allow read: if isAdmin() ||
          (isCollector() &&
            get(/databases/$(database)/documents/debts/$(
              get(/databases/$(database)/documents/installment_plans/$(planId))
                .data.debtId)).data.assignedCollectorId == request.auth.uid);
        allow write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isCollector() &&
          request.resource.data.collectorId == request.auth.uid &&
          request.resource.data.isCancelled == false &&
          get(/databases/$(database)/documents/debts/$(request.resource.data.debtId))
            .data.assignedCollectorId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /handovers/{handoverId} {
      allow read: if isAdmin() ||
        (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isCollector() && request.resource.data.collectorId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /visits/{visitId} {
      allow read: if isAdmin() ||
        (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isCollector() && request.resource.data.collectorId == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /collection_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Chat ──────────────────────────────────────────────────────────────────

    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }
      function willBeParticipant() {
        return signedIn() && request.auth.uid in request.resource.data.participantIds;
      }
      function onlyAllowedConvFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'unreadCounts', 'memberLastRead'
        ]);
      }
      function onlyMembershipFields() {
        // Allow creator/admin to add or remove members on group conversations only.
        // participantIds must remain non-empty to guard against accidental wipe-out.
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantIds', 'participantNames', 'lastMessage', 'lastMessageAt'
        ]) && resource.data.type == 'group'
           && request.resource.data.participantIds.size() >= 1;
      }

      allow read:   if isParticipant();
      allow create: if signedIn() && willBeParticipant()
                       && request.resource.data.participantIds.size() >= 2
                       && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isParticipant() && onlyAllowedConvFields())
                       || (isAdmin() && isParticipant())
                       || (isParticipant() && onlyMembershipFields()
                           && (isAdmin() || resource.data.createdBy == request.auth.uid));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function inConversation() {
          return signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        }
        function isSender() {
          return resource.data.senderId == request.auth.uid;
        }
        function conversationAllowsWrite() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return conv.writeRestriction == null
              || conv.writeRestriction == 'all'
              || (conv.writeRestriction == 'admin_only' && isAdmin());
        }

        allow read:   if inConversation();
        allow create: if inConversation() && conversationAllowsWrite()
                         && request.resource.data.senderId == request.auth.uid
                         && request.resource.data.keys().hasAll(
                              ['senderId', 'senderName', 'text', 'type', 'sentAt']);
        allow update: if isSender()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['deletedAt', 'deletedBy']);
        allow delete: if false;
      }
    }
  }
}