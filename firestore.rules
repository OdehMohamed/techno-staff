rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserDoc() {
      return get(currentUserPath());
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function isAdmin() {
      return signedIn() &&
        exists(currentUserPath()) &&
        currentUserData().role == 'admin';
    }

    function isCurrentUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function taskCreator() {
      return resource.data.assignedBy == request.auth.uid;
    }

    function taskAssignee() {
      return resource.data.assignedTo == request.auth.uid;
    }

    function creatingOwnTask() {
      return request.resource.data.assignedBy == request.auth.uid;
    }

    function onlyAllowedTaskStatusFieldsChanged() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'status',
          'updatedAt',
          'completedAt',
          'updatedBy',
          'updatedByName',
          'currentCount',
        ]);
    }

    function relatedTask(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId));
    }

    function canReadTaskLog(taskId) {
      return isAdmin() ||
        relatedTask(taskId).data.assignedBy == request.auth.uid ||
        relatedTask(taskId).data.assignedTo == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isAdmin() || isCurrentUser(userId);

      allow update: if isAdmin() || (
        isCurrentUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['languageCode', 'name'])
      );

      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || taskCreator() || taskAssignee();

      allow create: if signedIn() && (
        creatingOwnTask()
      );

      allow update: if (
        (isAdmin() || taskCreator())
        && request.resource.data.assignedBy == resource.data.assignedBy
      ) || (taskAssignee() && onlyAllowedTaskStatusFieldsChanged());

      allow delete: if isAdmin() || taskCreator();
    }

    match /task_logs/{logId} {
      allow read: if signedIn() && canReadTaskLog(resource.data.taskId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    match /task_templates/{templateId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.assignedBy == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.assignedBy == resource.data.assignedBy;
      allow delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /attendance_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fcm_tokens/{userId} {
      allow write: if isCurrentUser(userId);
      allow read: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}